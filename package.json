{
  "name": "@clearglassinc/opal-koboi",
  "version": "2.0.0",
  "description": "ClearGlass Inc. advanced automation layer for operational intelligence, workflow control, and disciplined execution.",
  "type": "module",
  "license": "MIT",
  "author": "ClearGlass Inc.",
  "homepage": "https://clearglassinc.github.io/opal/",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "opal-koboi": "./bin/opal-koboi.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClearGlassInc/Opal-Koboi.git"
  },
  "bugs": {
    "url": "https://github.com/ClearGlassInc/Opal-Koboi/issues"
  },
  "keywords": [
    "clearglass",
    "opal-koboi",
    "automation",
    "operations",
    "intelligence",
    "workflow-control"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/opal-koboi.js status",
    "opal": "node bin/opal-koboi.js",
    "plan": "node bin/opal-koboi.js plan",
    "run": "node bin/opal-koboi.js run",
    "validate": "node scripts/validate-package.mjs",
    "test": "npm run validate && node test/opal-koboi.test.mjs",
    "build": "node scripts/build-package.mjs",
    "ci": "npm test && npm run build",
    "prepack": "npm run ci"
  },
  "files": [
    "README.md",
    "LICENSE*",
    "bin/**/*",
    "docs/**/*",
    "src/**/*",
    "dist/**/*",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
